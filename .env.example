# Required: create a bot with @BotFather and set its token here.
TELEGRAM_BOT_TOKEN=

# SQLite is the default. For PostgreSQL, set:
# TREND_FINDER_DATABASE_URL=postgresql+asyncpg://trend_finder:change-me@postgres:5432/trend_finder
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
LOG_DIR=logs
REFRESH_COUNTRIES=US,GB,IR
HTTP_USER_AGENT=TrendFinderBot/1.0 (contact: configure-your-contact)
